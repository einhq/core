# EiN container
#
# EiN: Deno, core and its Web UI, built in. Nothing else. The modules are
# the deployment's: it mounts them at DEV_MODULES_PATH (empty here, so the image boots without any),
# and `mod install` puts the ones it fetches in MODULE_INSTALL_PATH, a folder of the host's mounted
# read-write so they outlive the container (unmounted, /app/modules-installed, gone with it). Every
# media tool and every model — exiftool, ImageMagick, ffmpeg, the CUDA stack, captioning,
# transcription, embeddings, faces, voices, fingerprints, document text, the renditions and the
# transcodes — lives in EMS (ein/ems), a service of its own that EiN reaches over HTTP at
# CFG_EMS_URL. EMS mounts none of EiN's files: it reaches each request's through the ems module's
# ems-files service, on CFG_EMS_FILES_PORT. See docs/architecture.md, "The ems module".
#
# Build:
#   podman build -t ein -f src/Containerfile .
#
# GitHub publishes it as ghcr.io/einhq/core (.github/workflows/image.yml). src/build.json, when the
# build finds one, is what system-info reports the image runs.
#
# Run, under rootless podman as yourself (root in a rootless container is the user running podman),
# with no capabilities:
#   podman run --rm --user 0 --cap-drop all --security-opt no-new-privileges \
#              -p 8080:8080 \
#              -p 2222:2222 \
#              -e POSTGRES_URL=postgres://ein:ein@host.containers.internal:5432/ein \
#              -e CFG_EMS_URL=http://host.containers.internal:8181 -e CFG_EMS_KEY=… \
#              -v ./files:/files \
#              -e MODULE_INSTALL_PATH=/modules-installed -v ./modules-installed:/modules-installed \
#              ein
#
# No GPU is passed to this container: the card is EMS's.
#
# It runs as ein, uid 65532, or as the user the deployment gives it (compose's user:), the owner of
# its data folder, and needs no capability: its ports are above 1024 and the files it writes are its
# own.
#
# Debian is pinned to the same tag as EiN's other images (ein/db, ein/ems), so the layer is shared;
# the three bump it together. Deno is its makers' binary, from their image that holds nothing else.
# NOTICE.md, in /usr/share/doc/ein-core/, says what the image passes on under which licence.

FROM docker.io/denoland/deno:bin-2.9.6 AS deno
FROM --platform=$BUILDPLATFORM docker.io/denoland/deno:bin-2.9.6 AS build-deno

# The guide the Docs page shows: einhq.eu's documentation, from the site's repository as DOCS_URL
# archives it: by default one commit of github.com/einhq/einhq.github.io, a snapshot the daily
# publish reviewed, never its main, which a pull request merged on GitHub changes unreviewed. The
# publish moves it on to each new snapshot of the site, in a commit here (ein/core#1499); another
# commit's or a fork's archive works as well. Cut down to what its pages need, in the site's layout
# so their relative links hold: the Markdown and diagrams under docs/, the screenshots they name with
# their 2x files, and the diagrams' fonts. It is the same on every platform, so it is cut once, on
# the builder's.
FROM --platform=$BUILDPLATFORM docker.io/library/debian:trixie-20261027-slim AS guide
ARG DOCS_URL=https://github.com/einhq/einhq.github.io/archive/378a4cc55201978bb584902dc28bebb09c56bbbc.tar.gz
ADD ${DOCS_URL} /site.tar.gz
WORKDIR /site
RUN tar -xzf /site.tar.gz --strip-components=1 \
  && mkdir -p /guide/assets/fonts \
  && find docs \( -name '*.md' -o -name '*.svg' \) -exec cp --parents {} /guide/ \; \
  && cp LICENSE ATTRIBUTION.md /guide/ \
  && cp assets/fonts/familjen-grotesk-*.woff2 assets/fonts/fragment-mono-*.woff2 assets/fonts/OFL-familjen-grotesk.txt assets/fonts/OFL-fragment-mono.txt /guide/assets/fonts/ \
  && grep -rhoE 'assets/shots/[^)" ]+\.webp' docs --include='*.md' | sort -u | while read -r shot; do \
    cp --parents "$shot" /guide/; \
    if [ -f "${shot%.webp}@2x.webp" ]; then cp --parents "${shot%.webp}@2x.webp" /guide/; fi; \
  done \
  && test -f /guide/docs/SUMMARY.md

# The Web UI's bundle, which is the same on every platform, so it is built once, on the builder's:
# under emulation the bundler is slow, and on arm64 it has died of an illegal instruction.
FROM --platform=$BUILDPLATFORM docker.io/library/debian:trixie-20261027-slim AS ui
COPY --from=build-deno /deno /usr/local/bin/deno
WORKDIR /app
COPY src src
COPY deno.jsonc deno.jsonc
COPY deno.lock deno.lock
COPY version.json version.json
RUN deno cache src/main.ts && deno task bundle-ui

FROM docker.io/library/debian:trixie-20261027-slim

# tini is PID 1: it passes the stop signal on to Deno and reaps the processes Deno starts.
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 65532 --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin ein

COPY --from=deno /deno /usr/local/bin/deno
ADD https://raw.githubusercontent.com/denoland/deno/v2.9.6/LICENSE.md /usr/share/doc/deno/LICENSE.md
COPY NOTICE.md /usr/share/doc/ein-core/NOTICE.md

# Deno's cache, where `deno cache` below leaves core's dependencies; DENO_USE_CGROUPS sizes Deno's
# heap to the container's memory limit rather than the machine's.
ENV DENO_DIR=/deno-dir/ \
    DENO_USE_CGROUPS=1

WORKDIR /app

COPY src src
COPY --from=guide /guide guide
COPY deno.jsonc deno.jsonc
COPY deno.lock deno.lock
COPY version.json version.json
COPY Makefile Makefile
COPY LICENSE LICENSE

# The shell asserts `x` on a bin as the calling user, and the mount of core's files takes its mode
# from this stat. A bin that reached the checkout as 644 would then run for admin only.
RUN chmod +x src/builtin/core/bin/* && mkdir -p modules modules-installed

# Deno adds the packages a module imports that core's lock lacks to deno.lock, replacing the file,
# which takes a folder its user can write: the lock is in /var/lib/ein, which any user can, as Deno's
# cache and modules-installed are.
RUN deno cache src/main.ts \
 && mkdir -m 777 /var/lib/ein && mv deno.lock /var/lib/ein/ && ln -s /var/lib/ein/deno.lock deno.lock \
 && chmod -R a+rwX /deno-dir modules-installed
COPY --from=ui /app/src/builtin/ui/ui src/builtin/ui/ui

ENV POSTGRES_URL=postgres://ein:ein@postgres:5432/ein
ENV CFG_HTTP_PORT=8080
ENV FILE_ROOT_PATH=/files

EXPOSE 8080
EXPOSE 2222

USER ein
ENTRYPOINT ["tini", "--"]
CMD ["deno", "run", "-A", "src/main.ts"]
