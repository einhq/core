# EiN container
#
# The primary instance: Deno, core and its web interface, built in. Nothing else. The modules are
# the deployment's: it mounts them at DEV_MODULES_PATH (empty here, so the image boots without any),
# and `mod install` puts the ones it fetches in MODULE_INSTALL_PATH, a folder of the host's mounted
# read-write so they outlive the container (unmounted, /app/modules-installed, gone with it). Every
# media tool and every model — exiftool, ImageMagick, ffmpeg, the CUDA stack, captioning,
# transcription, embeddings, faces, voices, fingerprints, document text, the renditions and the
# transcodes — lives in EMS (ein/ems), a service of its own that EiN reaches over HTTP at
# CFG_EMS_URL and that mounts the same /files, /old, /files-volatile and /files-tmp. See
# docs/architecture.md, "The ems module".
#
# Build:
#   podman build -t ein -f src/Containerfile .
#
# GitHub publishes it as ghcr.io/einhq/core (.github/workflows/image.yml). src/build.json, when the
# build finds one, is what system-info reports the image runs.
#
# Run:
#   podman run --rm \
#              -p 8080:8080 \
#              -p 2222:2222 \
#              -e POSTGRES_URL=postgres://ein:ein@host.containers.internal:5432/ein \
#              -e CFG_EMS_URL=http://host.containers.internal:8181 -e CFG_EMS_KEY=… \
#              -v ./files:/files \
#              -e MODULE_INSTALL_PATH=/modules-installed -v ./modules-installed:/modules-installed \
#              ein
#
# No GPU is passed to this container: the card is EMS's.

# The guide the Docs page shows: einhq.eu's documentation, from the site's repository as DOCS_URL
# archives it (main by default; a tag's or a fork's archive works as well). Cut down to what its
# pages need, in the site's layout so their relative links hold: the Markdown and diagrams under
# docs/, the screenshots they name with their 2x files, and the diagrams' fonts. It is the same on
# every platform, so it is cut once, on the builder's.
FROM --platform=$BUILDPLATFORM docker.io/denoland/deno:debian-2.9.6 AS guide
ARG DOCS_URL=https://github.com/einhq/einhq.github.io/archive/refs/heads/main.tar.gz
ADD ${DOCS_URL} /site.tar.gz
WORKDIR /site
RUN tar -xzf /site.tar.gz --strip-components=1 \
  && mkdir -p /guide/assets/fonts \
  && find docs \( -name '*.md' -o -name '*.svg' \) -exec cp --parents {} /guide/ \; \
  && cp LICENSE ATTRIBUTION.md /guide/ \
  && cp assets/fonts/familjen-grotesk-*.woff2 assets/fonts/fragment-mono-*.woff2 assets/fonts/OFL-familjen-grotesk.txt assets/fonts/OFL-fragment-mono.txt /guide/assets/fonts/ \
  && grep -rhoE 'assets/shots/[^)" ]+\.webp' docs --include='*.md' | sort -u | while read -r shot; do \
    cp --parents "$shot" /guide/; \
    if [ -f "${shot%.webp}@2x.webp" ]; then cp --parents "${shot%.webp}@2x.webp" /guide/; fi; \
  done \
  && test -f /guide/docs/SUMMARY.md

FROM docker.io/denoland/deno:debian-2.9.6

WORKDIR /app

COPY src src
COPY --from=guide /guide guide
COPY deno.jsonc deno.jsonc
COPY deno.lock deno.lock
COPY Makefile Makefile

# The shell asserts `x` on a bin as the calling user, and the mount of core's files takes its mode
# from this stat. A bin that reached the checkout as 644 would then run for admin only.
RUN chmod +x src/builtin/core/bin/* && mkdir -p modules modules-installed

RUN deno cache src/primary-main.ts && deno task bundle-ui

ENV POSTGRES_URL=postgres://ein:ein@postgres:5432/ein
ENV CFG_HTTP_PORT=8080
ENV FILE_ROOT_PATH=/files

EXPOSE 8080
EXPOSE 2222

CMD ["deno", "run", "-A", "src/primary-main.ts"]
